# Entorno
NODE_ENV=development
PORT=4000
API_PREFIX=/api
CORS_ORIGINS=http://localhost:4200

# Supabase (Project Settings > API)
# SUPABASE_SERVICE_ROLE_KEY es opcional: solo para operaciones administrativas.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Conexión directa a la base de datos para migraciones (obtener desde Supabase: Settings > Database)
DATABASE_URL=

# AWS (usar un usuario/rol IAM con privilegios minimos, nunca credenciales root)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=mingo-documentos
AWS_LAMBDA_FUNCTION_NAME=mingo-document-processor
AWS_SNS_TOPIC_ARN=
AWS_SQS_QUEUE_URL=

# Inteligencia artificial
# Opcion A: Google Gemini con tier gratuito (desarrollo y demo).
#   AI_PROVIDER=gemini
#   AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#   AI_EMBEDDING_MODEL=gemini-embedding-001
# Opcion B: OpenAI (produccion). Costo de embeddings: ~$0.02 por millon de tokens.
# La clave se obtiene en https://aistudio.google.com/apikey o https://platform.openai.com/api-keys
AI_PROVIDER=openai
AI_API_KEY=
AI_BASE_URL=
AI_CHAT_MODEL=gpt-4o-mini
AI_EMBEDDING_MODEL=text-embedding-3-small
# Debe coincidir con la columna vector(n) de fragmentos_documento.
AI_EMBEDDING_DIMENSIONS=1536

# Limites
MAX_UPLOAD_MB=20
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX_REQUESTS=300
