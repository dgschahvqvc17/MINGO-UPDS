{
  "name": "mingo-backend",
  "version": "1.0.0",
  "description": "API REST de MINGO - plataforma academica inteligente",
  "main": "src/server.js",
  "type": "commonjs",
  "private": true,
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.js\" \"tests/**/*.js\"",
    "migrate": "node scripts/run-migrations.js"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/server.js"
    ],
    "clearMocks": true
  },
  "keywords": [
    "mingo",
    "express",
    "supabase",
    "aws",
    "rag"
  ],
  "author": "MINGO",
  "license": "ISC",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@aws-sdk/client-lambda": "^3.1164.0",
    "@aws-sdk/client-s3": "^3.1164.0",
    "@aws-sdk/client-scheduler": "^3.1164.0",
    "@aws-sdk/client-sns": "^3.1164.0",
    "@aws-sdk/client-sqs": "^3.1164.0",
    "@aws-sdk/s3-request-presigner": "^3.1164.0",
    "@supabase/supabase-js": "^2.119.0",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.3",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mammoth": "^1.13.0",
    "morgan": "^1.12.1",
    "multer": "^2.5.0",
    "officeparser": "^8.4.1",
    "openai": "^7.53.0",
    "pdf-parse": "^2.4.5",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "jest": "^30.5.2",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.10",
    "supertest": "^7.3.1"
  }
}
