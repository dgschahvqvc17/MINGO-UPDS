{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "UbicacionBucketArtefactos",
      "Effect": "Allow",
      "Action": ["s3:GetBucketLocation"],
      "Resource": "arn:aws:s3:::mingo-documentos-dev-591015654164",
      "Condition": { "Bool": { "aws:SecureTransport": "true" } }
    },
    {
      "Sid": "ListarArtefactosDev",
      "Effect": "Allow",
      "Action": ["s3:ListBucket", "s3:ListBucketMultipartUploads"],
      "Resource": "arn:aws:s3:::mingo-documentos-dev-591015654164",
      "Condition": { "StringLike": { "s3:prefix": "tmp/artifacts/*" } }
    },
    {
      "Sid": "SubirArtefactosDev",
      "Effect": "Allow",
      "Action": ["s3:PutObject", "s3:AbortMultipartUpload", "s3:ListMultipartUploadParts"],
      "Resource": "arn:aws:s3:::mingo-documentos-dev-591015654164/tmp/artifacts/*",
      "Condition": { "Bool": { "aws:SecureTransport": "true" } }
    }
  ]
}
